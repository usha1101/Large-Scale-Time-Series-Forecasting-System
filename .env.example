# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Authentication (Change SECRET_KEY in production)
SECRET_KEY=change-this-to-a-secure-random-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forecast_db

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Directories
ARTIFACTS_DIR=ml/artifacts
DATA_DIR=data
